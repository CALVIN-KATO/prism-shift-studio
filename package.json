{
  "name": "prism-shift-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Prism Shift Studio - full-stack agency website (Express + SQLite + React)",
  "scripts": {
    "migrate": "node database/db.js",
    "seed": "node database/seed.js",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "client:install": "npm --prefix client install",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.1.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0"
  }
}
